# Copy to .env (or just run ./setup.sh, which writes .env for you).
# Every variable is optional: the compose files fall back to these same defaults.

# Services ./setup.sh up starts (space separated): postgres mysql mongo redis neo4j adminer mailpit rabbitmq livekit otel elk
SERVICES='postgres redis adminer mailpit'

# Network: 127.0.0.1 = only this machine can connect. 0.0.0.0 = anyone on your network.
BIND_IP='127.0.0.1'

# PostgreSQL (+ pgvector)
POSTGRES_PORT='5432'
POSTGRES_USER='postgres'
POSTGRES_PASSWORD='postgres'
POSTGRES_DB='postgres'

# MySQL
MYSQL_PORT='3306'
MYSQL_ROOT_PASSWORD='mysql'
MYSQL_DATABASE='app'

# MongoDB (no auth)
MONGO_PORT='27017'

# Redis
REDIS_PORT='6379'

# Neo4j (password must be 8+ characters)
NEO4J_HTTP_PORT='7474'
NEO4J_BOLT_PORT='7687'
NEO4J_PASSWORD='password123'

# Adminer (database web UI)
ADMINER_PORT='4000'
ADMINER_DESIGN='flat'
ADMINER_DEFAULT_SERVER='postgres'

# Mailpit (catches all outgoing email)
MAILPIT_SMTP_PORT='1025'
MAILPIT_UI_PORT='8025'

# RabbitMQ
RABBITMQ_PORT='5672'
RABBITMQ_UI_PORT='15672'
RABBITMQ_USER='admin'
RABBITMQ_PASSWORD='admin'

# LiveKit (dev mode: key devkey / secret secret)
LIVEKIT_PORT='7880'
LIVEKIT_RTC_TCP_PORT='7881'
LIVEKIT_RTC_UDP_PORT='7882'

# Observability (OpenTelemetry Collector, Prometheus, Grafana, Jaeger)
OTEL_GRPC_PORT='4317'
OTEL_HTTP_PORT='4318'
PROMETHEUS_PORT='9090'
JAEGER_UI_PORT='16686'
GRAFANA_PORT='4444'
GRAFANA_ADMIN_USER='admin'
GRAFANA_ADMIN_PASSWORD='admin'

# Elasticsearch + Kibana
ELK_VERSION='9.5.5'
ES_PORT='9200'
ES_HEAP='512m'
KIBANA_PORT='5601'

